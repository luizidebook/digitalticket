generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ORGANIZER
  BUYER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TicketStatus {
  ISSUED
  VALIDATED
  USED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  CHARGEBACK
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  domain       String?  @unique
  logoUrl      String?
  primaryColor String   @default("#ff5c7a")
  accentColor  String   @default("#8b5cf6")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        User[]
  events       Event[]
  coupons      Coupon[]
  orders       Order[]
}

model User {
  id             String         @id @default(cuid())
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  name           String
  email          String         @unique
  passwordHash   String
  role           Role           @default(BUYER)
  refreshTokens  RefreshToken[]
  orders         Order[]
  checkIns       CheckIn[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, revokedAt])
}

model Event {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  type           String
  category       String?
  tags           String[]
  description    String?
  imageUrl       String?
  startsAt       DateTime?
  endsAt         DateTime?
  status         EventStatus  @default(DRAFT)
  publishedAt    DateTime?
  dates          EventDate[]
  lots           Lot[]
  orders         Order[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model EventDate {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label     String?
  startsAt  DateTime?
  endsAt    DateTime?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  lots      Lot[]
  createdAt DateTime @default(now())

  @@index([eventId, active, sortOrder])
}

model Lot {
  id           String      @id @default(cuid())
  eventId      String
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventDateId  String?
  eventDate    EventDate?  @relation(fields: [eventDateId], references: [id], onDelete: SetNull)
  name         String
  priceInCents Int
  capacity     Int
  sold         Int         @default(0)
  saleStartsAt DateTime?
  saleEndsAt   DateTime?
  maxPerOrder  Int         @default(10)
  sortOrder    Int         @default(0)
  active       Boolean     @default(true)
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([eventId, active, sortOrder])
  @@index([eventDateId])
}

model Coupon {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  percentageOff  Int?
  fixedOffCents  Int?
  maxUses        Int?
  usedCount      Int          @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean      @default(true)
  orders         Order[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, code])
}

model Order {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  buyerId        String
  buyer          User         @relation(fields: [buyerId], references: [id])
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id])
  couponId       String?
  coupon         Coupon?      @relation(fields: [couponId], references: [id])
  status         String       @default("PENDING_PAYMENT")
  subtotalCents  Int
  discountCents  Int          @default(0)
  totalCents     Int
  payment        Payment?
  items          OrderItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status, createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lotId          String
  lot            Lot      @relation(fields: [lotId], references: [id])
  quantity       Int
  unitPriceCents Int
  tickets        Ticket[]
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String?
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, externalId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String        @default("MERCADO_PAGO")
  method      String
  externalId  String?       @unique
  status      PaymentStatus @default(PENDING)
  amountCents Int
  rawPayload  Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Ticket {
  id          String       @id @default(cuid())
  orderItemId String
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  holderName  String
  holderEmail String
  qrTokenHash String       @unique
  checkInCode String       @unique
  status      TicketStatus @default(ISSUED)
  checkIns    CheckIn[]
  issuedAt    DateTime     @default(now())
  validatedAt DateTime?
  usedAt      DateTime?
  cancelledAt DateTime?
}

model CheckIn {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  operatorId String?
  operator   User?    @relation(fields: [operatorId], references: [id])
  result     String
  deviceId   String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([ticketId, createdAt])
}
