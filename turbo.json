{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", "build/**"] },
    "check": { "dependsOn": ["^check"], "outputs": [] },
    "test": { "dependsOn": ["^test"], "outputs": [] },
    "lint": { "dependsOn": ["^lint"], "outputs": [] }
  }
}
